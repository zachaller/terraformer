//kage:unit pixels

package main

// Draws the starfield and the planet as a ray-traced sphere on one screen quad.
// The planet is a geodesic hex grid (see sim/grid.go). Source image 0 is the
// tile atlas (see game/palette.go): one block per diamond with a pixel for
// every lattice point, in four bands: tile colour; building data (red:
// type + 1, or 0 for none; green: activity 0..1; blue: status, as
// sim.StatusKind); the tile's index (red + 256·green); relief (red:
// height, green: standing water, blue: how alive); animals (red: grazers,
// green: fish, blue: forest, where birds fly); and mineral deposits (red:
// ore, 0 for none; green: mineral × 64).
//
// Tile colours are blended smoothly and broken up with noise so the planet
// looks natural rather than like a ball of hexagons; buildings, selection
// and grid lines still follow the tiles.

var Center vec2      // planet centre on screen, pixels
var Radius float     // planet radius on screen, pixels
var Row0 vec3        // rows of the world-to-view rotation
var Row1 vec3
var Row2 vec3
var N float          // lattice steps along each icosahedron edge
var TileAngle float  // average angle between neighbouring tile centres
var Selected float   // selected tile's index, or -1 for none
var Time float       // seconds
var Light vec3       // unit light direction, view space
var Grid float       // tile grid line strength, 0 to hide
var GridAt vec3      // planet-space centre of the patch where grid lines show
var Clouds float     // cloud cover, 0 to 1 (0 outside the surface view)
var Air float        // how thick the air is, 0 to 1: the halo and twilight glow
var Mining float     // 1 while placing a mine: deposits stand out and glint

// A building being placed: its tile index (-1 means none), type + 1,
// whether the spot is valid, and the tiles it would heat or pollute (unused
// entries are -1), tinted AreaTint by AreaAmt. The arrays' size matches
// game.maxAreaCells.
var Ghost float
var GhostType float
var GhostOK float
var Area [90]float
var AreaAmt [90]float
var AreaTint vec3

// latticeWarpC and the two warp functions mirror sim's latticeWarp.
const latticeWarpC = 0.25

func latticeWarp(w vec3) vec3 {
	g := w - latticeWarpC*w*w
	return g / (g.x + g.y + g.z)
}

func latticeUnwarp(b vec3) vec3 {
	l := 1 - latticeWarpC/3
	for i := 0; i < 3; i++ {
		s := sqrt(max(1-4*latticeWarpC*l*b, vec3(1e-6)))
		h := dot((1-s)/(2*latticeWarpC), vec3(1)) - 1
		l -= h / dot(b/s, vec3(1))
	}
	return (1 - sqrt(max(1-4*latticeWarpC*l*b, vec3(0)))) / (2 * latticeWarpC)
}

// upperCorner and lowerCorner are the icosahedron's corners on its upper
// ring (26.6°N, longitude 72k) and lower ring (26.6°S, longitude 72k+36),
// as in sim's diamondCorners.
func upperCorner(k float) vec3 {
	a := mod(k, 5) * 1.2566370614359172
	return vec3(0.8944271909999159*cos(a), 0.4472135954999579, 0.8944271909999159*sin(a))
}

func lowerCorner(k float) vec3 {
	a := (mod(k, 5) + 0.5) * 1.2566370614359172
	return vec3(0.8944271909999159*cos(a), -0.4472135954999579, 0.8944271909999159*sin(a))
}

func cmul(a, b vec2) vec2 { return vec2(a.x*b.x-a.y*b.y, a.x*b.y+a.y*b.x) }

// cornerO, cornerP, cornerQ and cornerR are diamond dm's corners.
func cornerO(dm float) vec3 {
	if dm < 5 {
		return vec3(0, 1, 0)
	}
	return upperCorner(dm - 4)
}

func cornerP(dm float) vec3 {
	if dm < 5 {
		return upperCorner(dm)
	}
	return lowerCorner(dm - 5)
}

func cornerQ(dm float) vec3 {
	if dm < 5 {
		return upperCorner(dm + 1)
	}
	return lowerCorner(dm - 4)
}

func cornerR(dm float) vec3 {
	if dm < 5 {
		return lowerCorner(dm)
	}
	return vec3(0, -1, 0)
}

// latticeAt mirrors sim's Grid.latticeCoords: the diamond direction d falls
// in (x) and its continuous lattice coordinates there (y, z). Only the four
// faces spanning d's longitude can hold it: two in the north diamond k, two
// in the south diamond 5+k2.
func latticeAt(d vec3) vec3 {
	s := atan2(d.z, d.x) / 1.2566370614359172
	k := mod(floor(s), 5)
	k2 := mod(floor(s-0.5), 5)
	// Ring corners from two angles, stepping round by 36° and 72° with
	// fixed rotations rather than more sin and cos.
	a1 := k * 1.2566370614359172
	a2 := (k2 + 0.5) * 1.2566370614359172
	e1 := vec2(cos(a1), sin(a1)) // longitude of U_k
	e2 := vec2(cos(a2), sin(a2)) // longitude of L_k2
	c36 := vec2(0.8090169943749475, 0.5877852522924731)
	c72 := vec2(0.30901699437494745, 0.9510565162951535)
	r := 0.8944271909999159
	h := 0.4472135954999579
	un := vec3(0, 1, 0)
	us := vec3(0, -1, 0)
	uk := vec3(r*e1.x, h, r*e1.y)
	f := cmul(e1, c72)
	uk1 := vec3(r*f.x, h, r*f.y)
	f = cmul(e1, c36)
	lk := vec3(r*f.x, -h, r*f.y)
	l2 := vec3(r*e2.x, -h, r*e2.y)
	f = cmul(e2, c72)
	l21 := vec3(r*f.x, -h, r*f.y)
	f = cmul(e2, c36)
	u2 := vec3(r*f.x, h, r*f.y)

	// Faces as (first corner, P, Q): north diamond (N or L_k, U_k, U_k+1);
	// south diamond (U_k2+1 or S, L_k2, L_k2+1).
	dm := k
	upper := false
	a := un
	p := uk
	q := uk1
	best := dot(d, un+uk+uk1)
	if v := dot(d, lk+uk+uk1); v > best {
		best = v
		upper = true
		a = lk
	}
	if v := dot(d, u2+l2+l21); v > best {
		best = v
		dm = 5 + k2
		upper = false
		a, p, q = u2, l2, l21
	}
	if v := dot(d, us+l2+l21); v > best {
		dm = 5 + k2
		upper = true
		a, p, q = us, l2, l21
	}
	b := vec3(dot(d, cross(p, q)), dot(a, cross(d, q)), dot(a, cross(p, d)))
	w := latticeUnwarp(b / (b.x + b.y + b.z))
	if upper {
		return vec3(dm, N*(1-w.z), N*(1-w.y))
	}
	return vec3(dm, N*w.y, N*w.z)
}

// latticeDir mirrors sim.LatticeDir: the unit direction through lattice
// point ij (in steps, not fractions) of diamond dm.
func latticeDir(dm float, ij vec2) vec3 {
	f := ij / N
	a := cornerO(dm)
	w := vec3(1-f.x-f.y, f.x, f.y)
	if f.x+f.y > 1 {
		a = cornerR(dm)
		w = vec3(f.x+f.y-1, 1-f.y, 1-f.x)
	}
	b := latticeWarp(w)
	return normalize(a*b.x + cornerP(dm)*b.y + cornerQ(dm)*b.z)
}

// tileLocal returns where planet-space direction d falls relative to the
// centre of the tile at lattice point ij of diamond dm, measured on the plane
// touching the sphere at the tile centre, oriented north-up, in units of the
// average distance between tile centres. Building symbols are drawn in it.
func tileLocal(d vec3, dm float, ij vec2) vec2 {
	c := latticeDir(dm, ij)
	// Measured against the average spacing, not this tile's neighbours, so a
	// tile drawn from two diamonds comes out the same size from each.
	size := TileAngle
	up := vec3(0, 1, 0)
	if abs(c.y) > 0.99 {
		up = vec3(0, 0, 1)
	}
	east := normalize(cross(up, c))
	north := cross(c, east)
	off := d/dot(d, c) - c
	return vec2(dot(off, east), dot(off, north)) / size
}

// The lattice triangle around continuous lattice coordinates st:
// triOrigin is the lattice square it's in, triUpper says which half,
// triCorner gives its corners and triWeights st's barycentric weights for
// them.
func triOrigin(st vec2) vec2 {
	return clamp(floor(st), vec2(0), vec2(N-1))
}

func triUpper(st vec2) bool {
	fr := st - triOrigin(st)
	return fr.x+fr.y >= 1
}

// triCorner returns corner k (0, 1 or 2) of the lattice triangle around st.
func triCorner(st vec2, k int) vec2 {
	i0 := triOrigin(st)
	if triUpper(st) {
		if k == 0 {
			return i0 + vec2(1, 1)
		}
		if k == 1 {
			return i0 + vec2(0, 1)
		}
		return i0 + vec2(1, 0)
	}
	if k == 0 {
		return i0
	}
	if k == 1 {
		return i0 + vec2(1, 0)
	}
	return i0 + vec2(0, 1)
}

// triWeights returns st's barycentric weights for the three corners.
func triWeights(st vec2) vec3 {
	fr := st - triOrigin(st)
	if triUpper(st) {
		return vec3(fr.x+fr.y-1, 1-fr.x, 1-fr.y)
	}
	return vec3(1-fr.x-fr.y, fr.x, fr.y)
}

// atlasAt returns the atlas pixel for lattice point ij of diamond dm in
// band 0 (colour), 1 (buildings) or 2 (tile index).
func atlasAt(dm float, ij vec2, band float) vec4 {
	return imageSrc0UnsafeAt(imageSrc0Origin() + vec2(dm*(N+1)+ij.x+0.5, band*(N+1)+ij.y+0.5))
}

// Signed distance helpers for drawing buildings. Negative is inside.
func sdCircle(p vec2, r float) float {
	return length(p) - r
}

func sdBox(p vec2, b vec2) float {
	d := abs(p) - b
	return length(max(d, vec2(0))) + min(max(d.x, d.y), 0)
}

func sdSeg(p vec2, a vec2, b vec2) float {
	pa := p - a
	ba := b - a
	h := clamp(dot(pa, ba)/dot(ba, ba), 0, 1)
	return length(pa - ba*h)
}

func sdHex(p vec2, r float) float {
	k := vec3(-0.866025404, 0.5, 0.577350269)
	q := abs(p)
	q -= 2 * min(dot(k.xy, q), 0) * k.xy
	q -= vec2(clamp(q.x, -k.z*r, k.z*r), r)
	return length(q) * sign(q.y)
}

// cover turns a distance into antialiased coverage, aa being a pixel's size.
func cover(d float, aa float) float {
	return clamp(0.5-d/aa, 0, 1)
}

// paint layers colour c over dst with coverage m.
func paint(dst vec4, c vec3, m float) vec4 {
	return vec4(mix(dst.rgb, c, m), max(dst.a, m))
}

// artScale shrinks the building designs, drawn for a square of side 1, a
// little: a hex tile reaches only about 0.5 from its centre (art beyond that
// spills onto neighbouring tiles, which draw it too).
const artScale = 1.1

// building returns the colour (rgb) and coverage (a) of building type bt at
// tile-local position p (each axis in [-0.5, 0.5], y north). act is how hard
// it's running (0 to 1) and aa is a pixel's size in tile units. Types follow
// sim.BuildingType + 1. The designs follow the UX mocks' building sheet.
func building(bt float, p vec2, act float, aa float) vec4 {
	o := vec4(0)
	if bt == 1 { // lander: hexagonal pad, legs, white dome with a cyan ring
		legs := min(min(sdSeg(p, vec2(-0.3, -0.17), vec2(-0.47, -0.3)), sdSeg(p, vec2(0.3, -0.17), vec2(0.47, -0.3))), sdSeg(p, vec2(0, 0.3), vec2(0, 0.48)))
		o = paint(o, vec3(0.54, 0.59, 0.67), cover(legs-0.03, aa))
		hex := sdHex(p, 0.33)
		o = paint(o, vec3(0.54, 0.59, 0.67), cover(hex, aa))
		o = paint(o, vec3(0.23, 0.27, 0.35), cover(hex+0.035, aa))
		o = paint(o, vec3(0.91, 0.93, 0.96), cover(sdCircle(p, 0.21), aa))
		o = paint(o, vec3(0.35, 0.82, 0.96), cover(abs(sdCircle(p, 0.18))-0.035, aa))
		o = paint(o, vec3(0.35, 0.82, 0.96), cover(sdCircle(p, 0.075), aa))
		blink := step(0.5, fract(Time*0.8))
		o = paint(o, vec3(1, 0.88, 0.54), cover(sdCircle(p-vec2(0.33, 0.33), 0.04), aa)*(0.4+0.6*blink))
		return o
	}
	if bt == 2 { // solar: four panels with a grid, and a glint while producing
		q := abs(p) - vec2(0.2, 0.18)
		panel := sdBox(q, vec2(0.17, 0.14))
		o = paint(o, vec3(0.61, 0.77, 1), cover(panel, aa))
		o = paint(o, vec3(0.12, 0.23, 0.47), cover(panel+0.025, aa))
		grid := min(abs(q.x), abs(q.y)) - 0.012
		o = paint(o, vec3(0.31, 0.47, 0.78), cover(grid, aa)*cover(panel+0.025, aa))
		band := abs(p.x+p.y-(fract(Time*0.25)*3-1.5)) - 0.05
		o = paint(o, vec3(1), cover(band, aa)*cover(panel+0.025, aa)*0.45*act)
		o = paint(o, vec3(0.79, 0.83, 0.89), cover(sdCircle(p, 0.05), aa))
		return o
	}
	if bt == 3 { // mine: terraced pit with ore flecks and a derrick
		o = paint(o, vec3(0.43, 0.33, 0.27), cover(sdCircle(p, 0.42), aa))
		o = paint(o, vec3(0.29, 0.22, 0.18), cover(sdCircle(p, 0.3), aa))
		o = paint(o, vec3(0.16, 0.12, 0.09), cover(sdCircle(p, 0.17), aa))
		ore := min(min(sdCircle(p-vec2(-0.22, 0.16), 0.035), sdCircle(p-vec2(0.25, 0.06), 0.03)), min(sdCircle(p-vec2(0.13, -0.27), 0.035), sdCircle(p-vec2(-0.26, -0.16), 0.03)))
		o = paint(o, vec3(0.95, 0.75, 0.29), cover(ore, aa))
		bob := 0.02 * sin(Time*6) * act
		derrick := min(min(sdSeg(p, vec2(-0.14, 0.2), vec2(0, 0.46)), sdSeg(p, vec2(0.14, 0.2), vec2(0, 0.46))), min(sdSeg(p, vec2(-0.08, 0.31), vec2(0.08, 0.31)), sdSeg(p, vec2(0, 0.46), vec2(0, 0.05+bob))))
		o = paint(o, vec3(0.79, 0.83, 0.89), cover(derrick-0.022, aa))
		return o
	}
	if bt == 4 { // smelter: furnace block, roof, chimney, glowing window, smoke
		smoke := min(sdCircle(p-vec2(0.22, 0.38+0.08*fract(Time*0.6)), 0.07), sdCircle(p-vec2(0.32, 0.46+0.06*fract(Time*0.6+0.5)), 0.05))
		o = paint(o, vec3(0.48, 0.44, 0.47), cover(smoke, aa)*0.7*act)
		o = paint(o, vec3(0.77, 0.42, 0.16), cover(sdBox(p-vec2(0, -0.1), vec2(0.4, 0.28)), aa))
		o = paint(o, vec3(0.56, 0.29, 0.11), cover(sdBox(p-vec2(0, 0.13), vec2(0.4, 0.06)), aa))
		o = paint(o, vec3(0.16, 0.16, 0.19), cover(sdBox(p-vec2(0.22, 0.2), vec2(0.075, 0.18)), aa))
		glow := 0.75 + 0.25*sin(Time*7)*act
		win := sdBox(p-vec2(-0.17, -0.2), vec2(0.15, 0.09))
		o = paint(o, vec3(1, 0.54, 0.24), cover(win, aa))
		o = paint(o, vec3(1, 0.83, 0.42)*glow, cover(win+0.025, aa))
		return o
	}
	if bt == 5 { // heater: warm glow, radiator fins, coil ring, hot core
		pulse := 0.85 + 0.15*sin(Time*3)
		o = paint(o, vec3(0.95, 0.65, 0.25), cover(sdCircle(p, 0.48), aa)*0.25*act*pulse)
		fins := 1.0
		for i := 0; i < 8; i++ {
			a := float(i) * 0.7853982
			dir := vec2(cos(a), sin(a))
			fins = min(fins, sdSeg(p, dir*0.3, dir*0.43))
		}
		o = paint(o, vec3(0.72, 0.23, 0.15), cover(fins-0.035, aa))
		o = paint(o, vec3(0.89, 0.33, 0.23), cover(abs(sdCircle(p, 0.24))-0.06, aa))
		o = paint(o, mix(vec3(0.75, 0.6, 0.35), vec3(1, 0.83, 0.42), act), cover(sdCircle(p, 0.12), aa))
		return o
	}
	if bt == 6 { // water extractor: frosty pad, ice shards, derrick with a bobbing bit
		o = paint(o, vec3(0.62, 0.74, 0.86), cover(sdHex(p, 0.38), aa))
		o = paint(o, vec3(0.3, 0.42, 0.56), cover(sdHex(p, 0.38)+0.04, aa))
		shards := min(min(sdSeg(p, vec2(-0.3, -0.1), vec2(-0.2, -0.3)), sdSeg(p, vec2(0.28, -0.2), vec2(0.16, -0.32))), sdSeg(p, vec2(0.25, 0.22), vec2(0.32, 0.05)))
		o = paint(o, vec3(0.85, 0.94, 1), cover(shards-0.03, aa))
		bob := 0.04 * sin(Time*8) * act
		tower := min(min(sdSeg(p, vec2(-0.12, -0.15), vec2(0, 0.36)), sdSeg(p, vec2(0.12, -0.15), vec2(0, 0.36))), sdSeg(p, vec2(0, 0.36), vec2(0, -0.2+bob)))
		o = paint(o, vec3(0.79, 0.83, 0.89), cover(tower-0.025, aa))
		o = paint(o, vec3(0.35, 0.82, 0.96), cover(sdCircle(p-vec2(0, -0.2+bob), 0.06), aa))
		return o
	}
	if bt == 7 { // electrolyser: two tanks joined by a pipe, oxygen bubbles rising
		o = paint(o, vec3(0.6, 0.66, 0.74), cover(sdBox(p-vec2(0, -0.02), vec2(0.3, 0.04)), aa))
		o = paint(o, vec3(0.32, 0.55, 0.9), cover(sdCircle(p-vec2(-0.2, 0), 0.17), aa))
		o = paint(o, vec3(0.37, 0.83, 0.71), cover(sdCircle(p-vec2(0.2, 0), 0.17), aa))
		o = paint(o, vec3(0.9, 0.95, 1), cover(sdCircle(p-vec2(-0.25, 0.06), 0.04), aa)*0.7)
		o = paint(o, vec3(0.9, 0.95, 1), cover(sdCircle(p-vec2(0.15, 0.06), 0.04), aa)*0.7)
		for i := 0; i < 3; i++ {
			f := fract(Time*0.5 + float(i)/3)
			o = paint(o, vec3(0.75, 1, 0.92), cover(sdCircle(p-vec2(0.2+0.06*sin(f*9+float(i)), 0.18+f*0.3), 0.035), aa)*(1-f)*act)
		}
		return o
	}
	if bt == 8 { // greenhouse factory: dark block, two stacks, warm haze
		haze := min(sdCircle(p-vec2(-0.15, 0.36+0.08*fract(Time*0.4)), 0.08), sdCircle(p-vec2(0.2, 0.4+0.07*fract(Time*0.4+0.5)), 0.07))
		o = paint(o, vec3(0.88, 0.48, 0.37), cover(haze, aa)*0.6*act)
		o = paint(o, vec3(0.42, 0.36, 0.5), cover(sdBox(p-vec2(0, -0.12), vec2(0.4, 0.24)), aa))
		o = paint(o, vec3(0.3, 0.26, 0.38), cover(sdBox(p-vec2(0, 0.08), vec2(0.4, 0.05)), aa))
		o = paint(o, vec3(0.2, 0.18, 0.24), cover(min(sdBox(p-vec2(-0.15, 0.16), vec2(0.06, 0.16)), sdBox(p-vec2(0.2, 0.18), vec2(0.06, 0.18))), aa))
		o = paint(o, vec3(0.69, 0.49, 0.91), cover(sdBox(p-vec2(-0.05, -0.18), vec2(0.22, 0.06)), aa))
		return o
	}
	if bt == 9 { // nitrogen plant: three pale tanks on a pad
		o = paint(o, vec3(0.45, 0.5, 0.58), cover(sdBox(p, vec2(0.42, 0.34)), aa))
		tanks := min(min(sdCircle(p-vec2(-0.2, -0.1), 0.15), sdCircle(p-vec2(0.2, -0.1), 0.15)), sdCircle(p-vec2(0, 0.17), 0.15))
		o = paint(o, vec3(0.5, 0.65, 0.91), cover(tanks, aa))
		o = paint(o, vec3(0.72, 0.84, 1), cover(tanks+0.05, aa))
		o = paint(o, vec3(0.5, 0.65, 0.91)*(0.7+0.3*act), cover(sdCircle(p-vec2(0, 0.17), 0.04), aa))
		return o
	}
	if bt == 10 { // dust spreader: dark mound with a spinning arm flinging dust
		o = paint(o, vec3(0.55, 0.41, 0.31), cover(sdCircle(p, 0.3), aa))
		o = paint(o, vec3(0.38, 0.27, 0.2), cover(sdCircle(p, 0.2), aa))
		a := Time * 2 * act
		dir := vec2(cos(a), sin(a))
		o = paint(o, vec3(0.79, 0.83, 0.89), cover(sdSeg(p, -dir*0.36, dir*0.36)-0.03, aa))
		for i := 0; i < 4; i++ {
			f := fract(Time*0.7 + float(i)/4)
			b := a + float(i)*1.57
			o = paint(o, vec3(0.6, 0.45, 0.33), cover(sdCircle(p-vec2(cos(b), sin(b))*(0.3+f*0.15), 0.03), aa)*(1-f)*act)
		}
		return o
	}
	if bt == 11 { // wind turbine: mast and three turning blades
		o = paint(o, vec3(0.6, 0.66, 0.74), cover(sdSeg(p, vec2(0, -0.45), vec2(0, 0))-0.03, aa))
		a := Time * 3 * act
		blades := 1.0
		for i := 0; i < 3; i++ {
			b := a + float(i)*2.094
			blades = min(blades, sdSeg(p, vec2(0), vec2(cos(b), sin(b))*0.42))
		}
		o = paint(o, vec3(0.92, 0.94, 0.97), cover(blades-0.035, aa))
		o = paint(o, vec3(0.6, 0.66, 0.74), cover(sdCircle(p, 0.07), aa))
		return o
	}
	if bt == 12 { // geothermal: dark rock, glowing vent, steam
		o = paint(o, vec3(0.25, 0.2, 0.2), cover(sdHex(p, 0.4), aa))
		glow := 0.8 + 0.2*sin(Time*4)
		o = paint(o, vec3(0.9, 0.3, 0.15)*glow, cover(sdCircle(p, 0.17), aa))
		o = paint(o, vec3(1, 0.75, 0.3)*glow, cover(sdCircle(p, 0.08), aa))
		steam := sdCircle(p-vec2(0.05, 0.25+0.15*fract(Time*0.5)), 0.08)
		o = paint(o, vec3(0.85, 0.87, 0.9), cover(steam, aa)*0.6*(1-fract(Time*0.5)))
		return o
	}
	if bt == 13 { // orbital mirror's focus: a bright spot with rays
		pulse := 0.85 + 0.15*sin(Time*2)
		o = paint(o, vec3(1, 0.9, 0.55), cover(sdCircle(p, 0.46), aa)*0.25*pulse)
		rays := 1.0
		for i := 0; i < 8; i++ {
			a := float(i)*0.785 + Time*0.3
			rays = min(rays, sdSeg(p, vec2(cos(a), sin(a))*0.22, vec2(cos(a), sin(a))*0.4))
		}
		o = paint(o, vec3(1, 0.85, 0.4), cover(rays-0.02, aa))
		o = paint(o, vec3(1, 0.97, 0.8), cover(sdCircle(p, 0.15), aa))
		return o
	}
	if bt == 14 { // comet target: red crosshair, closing in as impact nears
		r := 0.45 - 0.3*act
		o = paint(o, vec3(1, 0.42, 0.36), cover(abs(sdCircle(p, r))-0.025, aa))
		cross := min(sdSeg(p, vec2(-0.45, 0), vec2(-0.12, 0)), min(sdSeg(p, vec2(0.12, 0), vec2(0.45, 0)), min(sdSeg(p, vec2(0, -0.45), vec2(0, -0.12)), sdSeg(p, vec2(0, 0.12), vec2(0, 0.45)))))
		o = paint(o, vec3(1, 0.42, 0.36), cover(cross-0.02, aa)*(0.6+0.4*sin(Time*6)))
		return o
	}
	if bt == 15 { // magnetic shield: emitter dome inside turning field rings
		a := Time * 1.5
		for i := 0; i < 3; i++ {
			r := 0.2 + float(i)*0.1
			ring := abs(sdCircle(p, r)) - 0.015
			arc := sin(atan2(p.y, p.x)*2 + a*(1+float(i)*0.5))
			o = paint(o, vec3(0.45, 0.65, 1), cover(ring, aa)*smoothstep(-0.2, 0.6, arc)*act)
		}
		o = paint(o, vec3(0.6, 0.66, 0.74), cover(sdCircle(p, 0.15), aa))
		o = paint(o, vec3(0.75, 0.88, 1), cover(sdCircle(p-vec2(-0.04, 0.04), 0.07), aa))
		return o
	}
	if bt == 17 { // carbon scrubber: a block of fans pulling air through
		o = paint(o, vec3(0.33, 0.38, 0.43), cover(sdBox(p, vec2(0.38, 0.3)), aa))
		for i := 0; i < 3; i++ {
			c := vec2(-0.22+float(i)*0.22, 0)
			o = paint(o, vec3(0.16, 0.19, 0.23), cover(sdCircle(p-c, 0.09), aa))
			a := Time*6*act + float(i)
			o = paint(o, vec3(0.6, 0.66, 0.74), cover(sdSeg(p-c, vec2(cos(a), sin(a))*0.08, -vec2(cos(a), sin(a))*0.08)-0.015, aa))
		}
		return o
	}
	if bt == 18 { // pylon: a lattice tower with glowing insulators
		o = paint(o, vec3(0.2, 0.25, 0.32), cover(sdCircle(p, 0.16), aa)*0.6)
		tower := min(min(sdSeg(p, vec2(-0.12, -0.38), vec2(0, 0.36)), sdSeg(p, vec2(0.12, -0.38), vec2(0, 0.36))), min(sdSeg(p, vec2(-0.3, 0.22), vec2(0.3, 0.22)), sdSeg(p, vec2(-0.2, 0.02), vec2(0.2, 0.02))))
		o = paint(o, vec3(0.6, 0.66, 0.74), cover(tower-0.022, aa))
		glow := 0.7 + 0.3*sin(Time*3)
		o = paint(o, vec3(0.35, 0.82, 0.96)*glow, cover(min(sdCircle(p-vec2(-0.3, 0.22), 0.05), sdCircle(p-vec2(0.3, 0.22), 0.05)), aa))
		return o
	}
	if bt == 16 { // biolab: glass dome with plants inside
		o = paint(o, vec3(0.6, 0.66, 0.74), cover(sdCircle(p, 0.4), aa))
		o = paint(o, vec3(0.16, 0.3, 0.3), cover(sdCircle(p, 0.34), aa))
		leaves := min(min(sdCircle(p-vec2(-0.12, -0.05), 0.1), sdCircle(p-vec2(0.1, 0.06), 0.12)), sdCircle(p-vec2(0, -0.17), 0.08))
		o = paint(o, vec3(0.3, 0.7, 0.35), cover(leaves, aa))
		o = paint(o, vec3(0.85, 0.95, 1), cover(sdSeg(p, vec2(-0.2, 0.22), vec2(-0.05, 0.3))-0.02, aa)*0.6)
		return o
	}
	return o
}

// glowOf is the light building type bt gives off at tile-local position p
// while running at act: lamps, furnace windows and hot cores, added after
// lighting so they shine on the night side too.
func glowOf(bt float, p vec2, act float) vec3 {
	if bt == 1 { // lander: the cyan ring and the blinking beacon
		ring := exp(-pow(length(p)-0.18, 2) / 0.003)
		blink := step(0.5, fract(Time*0.8))
		return vec3(0.35, 0.82, 0.96)*ring*0.35 + vec3(1, 0.85, 0.5)*exp(-dot(p-vec2(0.33, 0.33), p-vec2(0.33, 0.33))/0.004)*blink*0.8
	}
	if bt == 4 { // smelter: the furnace window
		q := p - vec2(-0.17, -0.2)
		return vec3(1, 0.55, 0.2) * exp(-dot(q, q)/0.03) * 0.55 * act
	}
	if bt == 5 { // heater: the hot core and its warmth
		return vec3(1, 0.6, 0.25) * (exp(-dot(p, p)/0.02)*0.6 + exp(-dot(p, p)/0.15)*0.15) * act
	}
	if bt == 8 { // greenhouse factory: its lit panel
		q := p - vec2(-0.05, -0.18)
		return vec3(0.7, 0.45, 1) * exp(-dot(q, q)/0.03) * 0.3 * act
	}
	if bt == 12 { // geothermal: the vent
		return vec3(1, 0.45, 0.15) * exp(-dot(p, p)/0.025) * 0.6
	}
	if bt == 13 { // orbital mirror's focus
		return vec3(1, 0.9, 0.6) * exp(-dot(p, p)/0.05) * 0.5
	}
	if bt == 16 { // biolab: grow lights under the dome
		return vec3(0.4, 1, 0.55) * exp(-dot(p, p)/0.05) * 0.2 * act
	}
	if bt == 18 { // pylon: the insulators
		a := p - vec2(-0.3, 0.22)
		b := p - vec2(0.3, 0.22)
		return vec3(0.35, 0.82, 0.96) * (exp(-dot(a, a)/0.004) + exp(-dot(b, b)/0.004)) * 0.4
	}
	return vec3(0)
}

// mineralColor is the colour of mineral m (as sim.Mineral): gold iron,
// purple fluorite, pale green nitrate.
func mineralColor(m float) vec3 {
	if m < 0.5 {
		return vec3(0.95, 0.75, 0.29)
	}
	if m < 1.5 {
		return vec3(0.69, 0.49, 0.91)
	}
	return vec3(0.72, 0.88, 0.63)
}

// outcrop draws a deposit's boulders at tile-local position p: rounded
// rocks, scattered over the tile, flecked with their mineral (colour col),
// more of them the more ore is left. The patch's stained ground is drawn
// with the terrain. glint makes the flecks sparkle, for picking a spot to
// mine.
func outcrop(p vec2, seed float, ore float, col vec3, glint float, aa float) vec4 {
	o := vec4(0)
	l := normalize(vec3(-0.5, 0.6, 0.7))
	n := 1 + floor(ore*3+rnd(seed)*1.5)
	for i := 0; i < 4; i++ {
		if float(i) >= n {
			break
		}
		k := seed*2.9 + float(i)*4.3
		c := (vec2(rnd(k), rnd(k+1)) - 0.5) * 0.75
		r := 0.05 + 0.07*rnd(k+2)
		o = paint(o, vec3(0.02, 0.02, 0.03), cover(sdCircle(p-c-vec2(0.03, -0.035), r), aa)*0.4)
		// Shade it as a ball lit by the sun, with a dull shine.
		q := (p - c) / r
		nn := vec3(q, sqrt(max(1-dot(q, q), 0)))
		lit := max(dot(nn, l), 0)
		rock := mix(vec3(0.4, 0.36, 0.33), col, 0.2) * (0.35 + 0.8*lit)
		// Flecks of mineral catch the light, and sparkle while placing.
		f := hash(floor((p-c)*45) + seed)
		tw := pow(max(sin(Time*3+f*40), 0), 8) * glint
		fleck := min(col*1.5*(0.7+0.6*lit)+tw, vec3(1))
		inside := cover(sdCircle(p-c, r), aa)
		o = paint(o, mix(rock, fleck, step(0.75, f)), inside)
		o.rgb += vec3(pow(max(dot(reflect(-l, nn), vec3(0, 0, 1)), 0), 20)*0.4) * inside
	}
	return o
}

// rnd is a pseudo-random value in [0, 1) for x.
func rnd(x float) float {
	return hash(vec2(x, x*1.618+17.3))
}

// sdBody is roughly the distance from p to an oval body at c, heading dir,
// half ln long and half wid wide.
func sdBody(p vec2, c vec2, dir vec2, ln float, wid float) float {
	q := p - c
	return (length(vec2(dot(q, dir)/ln, dot(q, vec2(-dir.y, dir.x))/wid)) - 1) * wid
}

// creatures draws the animals living on a tile, at tile-local position p:
// a herd of grazers wandering and stopping to graze, fish schooling in the
// water, and birds circling over forest. seed is the tile's index, so each
// tile's animals keep to their own paths; aa is a pixel's size.
func creatures(p vec2, seed float, grazers float, fish float, forest float, wet float, aa float) vec4 {
	o := vec4(0)
	shade := vec3(0.02, 0.02, 0.03)
	if grazers > 0.03 && wet < 0.5 {
		n := ceil(grazers * 5)
		for i := 0; i < 5; i++ {
			if float(i) >= n {
				break
			}
			k := seed*7.31 + float(i)*3.7
			c := (vec2(rnd(k), rnd(k+1)) - 0.5) * 0.35
			// Wander, slowing almost to a stop now and then to graze.
			t := Time*0.22 + rnd(k+2)*40
			s := t - 0.85*sin(t)
			ph := rnd(k+3) * 6.28
			pos := c + 0.13*vec2(sin(s+ph), sin(s*1.37+ph*2))
			vel := vec2(cos(s+ph), 1.37*cos(s*1.37+ph*2))
			dir := normalize(vel + vec2(1e-4, 0))
			bob := 0.004 * sin(Time*9+k) * (1 - 0.85*cos(t))
			o = paint(o, shade, cover(sdBody(p, pos+vec2(0.012, -0.016), dir, 0.05, 0.026), aa)*0.35)
			coat := mix(vec3(0.36, 0.26, 0.17), vec3(0.55, 0.45, 0.33), rnd(k+4))
			o = paint(o, coat, cover(sdBody(p, pos+vec2(0, bob), dir, 0.05, 0.026), aa))
			o = paint(o, coat*0.75, cover(sdCircle(p-pos-dir*0.052-vec2(0, bob), 0.018), aa))
			o = paint(o, coat*1.25, cover(sdBody(p, pos+vec2(-0.004, bob+0.004), dir, 0.03, 0.01), aa)*0.6)
		}
	}
	if fish > 0.03 && wet > 0.3 {
		n := ceil(fish * 6)
		for i := 0; i < 6; i++ {
			if float(i) >= n {
				break
			}
			k := seed*5.17 + float(i)*2.3
			// A school swimming in loops, each fish a little behind the last.
			side := sign(rnd(seed) - 0.5)
			a := side*Time*0.5 - float(i)*0.32 + rnd(seed+9)*6.28
			r := 0.17 + 0.05*rnd(k)
			pos := vec2(cos(a), sin(a))*r + (vec2(rnd(k+1), rnd(k+2))-0.5)*0.06
			dir := side * vec2(-sin(a), cos(a))
			wiggle := 0.25 * sin(Time*12+k)
			tail := pos - dir*0.04 + vec2(-dir.y, dir.x)*wiggle*0.02
			fishC := mix(vec3(0.85, 0.92, 1), vec3(1, 0.75, 0.4), step(0.8, rnd(k+3)))
			o = paint(o, vec3(0.02, 0.06, 0.12), cover(sdBody(p, pos+vec2(0.01, -0.012), dir, 0.04, 0.015), aa)*0.3)
			o = paint(o, fishC, cover(min(sdBody(p, pos, dir, 0.04, 0.015), sdSeg(p, pos-dir*0.03, tail)-0.01), aa)*0.85)
		}
	}
	if forest > 0.4 {
		n := ceil((forest - 0.4) * 3.4)
		for i := 0; i < 2; i++ {
			if float(i) >= n {
				break
			}
			k := seed*3.91 + float(i)*5.1
			a := Time*0.7 + rnd(k)*6.28
			pos := vec2(cos(a), sin(a)) * (0.22 + 0.12*rnd(k+1))
			dir := vec2(-sin(a), cos(a))
			perp := vec2(-dir.y, dir.x)
			span := 0.075 * (0.55 + 0.45*abs(sin(Time*9+k)))
			// Its shadow on the ground, then the bird high above it.
			sp := pos + vec2(0.07, -0.09)
			wingsS := min(sdSeg(p, sp, sp+perp*span-dir*0.02), sdSeg(p, sp, sp-perp*span-dir*0.02)) - 0.006
			o = paint(o, shade, cover(wingsS, aa)*0.25)
			wings := min(sdSeg(p, pos, pos+perp*span-dir*0.025), sdSeg(p, pos, pos-perp*span-dir*0.025)) - 0.009
			o = paint(o, vec3(0.1, 0.1, 0.12), cover(min(wings, sdCircle(p-pos, 0.011)), aa))
		}
	}
	return o
}

// badge draws a building's status badge in its tile's top-right corner.
// Status codes follow sim.StatusKind; the glyph's shape carries the meaning.
func badge(st float, p vec2, aa float) vec4 {
	o := vec4(0)
	if st < 0.5 || st > 6.5 { // running, or a comet on its way
		return o
	}
	c := vec2(0.28, 0.28)
	r := 0.14
	q := (p - c) / r
	qa := aa / r
	bg := vec3(0.95, 0.65, 0.25) // short of power: amber
	glyph := 1.0
	if st < 1.5 {
		glyph = min(min(sdSeg(q, vec2(0.15, 0.65), vec2(-0.3, 0)), sdSeg(q, vec2(-0.3, 0), vec2(0.25, 0))), sdSeg(q, vec2(0.25, 0), vec2(-0.15, -0.65))) - 0.1
	} else if st < 2.5 { // no power, unlinked: blue, broken link
		bg = vec3(0.61, 0.77, 1)
		glyph = min(sdSeg(q, vec2(-0.5, -0.5), vec2(-0.12, -0.12)), sdSeg(q, vec2(0.12, 0.12), vec2(0.5, 0.5))) - 0.12
	} else if st < 4.5 { // no input, or output full: red "!"
		bg = vec3(1, 0.54, 0.48)
		glyph = min(sdSeg(q, vec2(0, 0.5), vec2(0, -0.08)), sdCircle(q-vec2(0, -0.48), 0.1)) - 0.1
	} else { // deposit empty: grey "-"
		bg = vec3(0.79, 0.83, 0.89)
		glyph = sdSeg(q, vec2(-0.45, 0), vec2(0.45, 0)) - 0.12
	}
	o = paint(o, vec3(0.03, 0.04, 0.06), cover(sdCircle(q, 1.18), qa))
	o = paint(o, bg, cover(sdCircle(q, 1), qa))
	o = paint(o, vec3(0.06, 0.07, 0.1), cover(glyph, qa))
	return o
}

// hash3 is a pseudo-random value in [0, 1) for lattice point p. It avoids
// sin(): many phone GPUs compute sin() of large arguments inaccurately, which
// turned the "random" values into visible stripes and blocks.
func hash3(p vec3) float {
	q := fract(p * 0.1031)
	q += dot(q, q.zyx+31.32)
	return fract((q.x + q.y) * q.z)
}

// vnoise is 3D value noise in [0, 1]. Evaluated in planet space, so it's
// continuous across the grid's seams.
func vnoise(p vec3) float {
	i := floor(p)
	t := fract(p)
	u := t * t * (3 - 2*t)
	a := mix(hash3(i), hash3(i+vec3(1, 0, 0)), u.x)
	b := mix(hash3(i+vec3(0, 1, 0)), hash3(i+vec3(1, 1, 0)), u.x)
	c := mix(hash3(i+vec3(0, 0, 1)), hash3(i+vec3(1, 0, 1)), u.x)
	e := mix(hash3(i+vec3(0, 1, 1)), hash3(i+vec3(1, 1, 1)), u.x)
	return mix(mix(a, b, u.y), mix(c, e, u.y), u.z)
}

// smoothBand blends an atlas band's values for the three tiles around
// lattice position l (from latticeAt), favouring the nearest so each tile's
// own value shows (sharp sets how much).
func smoothBand(l vec3, band float, sharp float) vec4 {
	w := pow(triWeights(l.yz), vec3(sharp))
	w /= w.x + w.y + w.z
	return atlasAt(l.x, triCorner(l.yz, 0), band)*w.x +
		atlasAt(l.x, triCorner(l.yz, 1), band)*w.y +
		atlasAt(l.x, triCorner(l.yz, 2), band)*w.z
}

// cloudsAt is the cloud cover at planet direction c: noise, banded by
// latitude like a planet's weather, thicker the cloudier the planet.
func cloudsAt(c vec3) float {
	// Swirl the noise a little so clouds stream rather than sit in blobs.
	c += (vec3(vnoise(c*2), vnoise(c*2+11.3), vnoise(c*2+23.7)) - 0.5) * 0.35
	v := vnoise(c*3)*0.55 + vnoise(c*7)*0.28 + vnoise(c*17)*0.17 + 0.08*cos(c.y*7)
	return smoothstep(0.62-0.14*Clouds, 0.82-0.1*Clouds, v)
}

// hash is hash3 for 2D points (the starfield).
func hash(p vec2) float {
	q := fract(vec3(p.x, p.y, p.x) * 0.1031)
	q += dot(q, q.yzx+33.33)
	return fract((q.x + q.y) * q.z)
}

func Fragment(dstPos vec4, srcPos vec2, color vec4) vec4 {
	atmo := vec3(0.45, 0.62, 1.0)

	// Screen position relative to the planet, y up.
	q := (dstPos.xy - Center) / Radius
	q = vec2(q.x, -q.y)
	r2 := dot(q, q)

	if r2 > 1 {
		space := vec3(0.01, 0.012, 0.03)
		h := hash(floor(dstPos.xy))
		if h > 0.997 {
			space += vec3((h - 0.997) / 0.003 * 0.8)
		}
		// Thin atmospheric halo just outside the limb.
		g := clamp(1-(sqrt(r2)-1)/0.06, 0, 1)
		return vec4(mix(space, atmo, g*g*0.5), 1)
	}

	// Surface normal in view space, then rotate back to planet space.
	n := vec3(q, sqrt(1-r2))
	d := Row0*n.x + Row1*n.y + Row2*n.z

	// The tile here: the lattice point nearest d (the corner of its
	// lattice triangle with the largest weight). How far that weight leads
	// the next one says how close d is to the tile's edge.
	l := latticeAt(d)
	dm := l.x
	tw := triWeights(l.yz)
	ij := triCorner(l.yz, 0)
	wmax := tw.x
	w2 := max(tw.y, tw.z)
	if tw.y > tw.x && tw.y >= tw.z {
		ij = triCorner(l.yz, 1)
		wmax = tw.y
		w2 = max(tw.x, tw.z)
	} else if tw.z > tw.x && tw.z > tw.y {
		ij = triCorner(l.yz, 2)
		wmax = tw.z
		w2 = max(tw.x, tw.y)
	}
	idxData := atlasAt(dm, ij, 2)
	tile := floor(idxData.r*255+0.5) + 256*floor(idxData.g*255+0.5)
	edgeW := wmax - w2
	edgePx := edgeW / max(fwidth(edgeW), 1e-4) // pixels from the tile's edge

	// Warp the colour lookup with noise so region edges wander organically
	// instead of following the grid, then add fine surface texture. tf is
	// about how many tiles span a quarter of the planet.
	tf := 1.5708 / TileAngle
	q3 := d * tf * 0.9
	// Two octaves, so region edges stay irregular even when a single tile
	// fills much of the screen.
	q4 := d * tf * 3.1
	warp := vec3(vnoise(q3), vnoise(q3+vec3(17.3, 5.1, 9.7)), vnoise(q3+vec3(41.7, 23.9, 3.3))) - 0.5
	warp += (vec3(vnoise(q4+vec3(3.7, 11.1, 29.3)), vnoise(q4+vec3(59.1, 7.3, 13.9)), vnoise(q4+vec3(23.3, 37.7, 5.9))) - 0.5) * 0.45
	sl := latticeAt(normalize(d + warp*TileAngle*1.4))
	base := smoothBand(sl, 0, 3).rgb
	relief := smoothBand(sl, 3, 1)
	wet := relief.g
	detail := vnoise(d*tf*2.5)*0.6 + vnoise(d*tf*6)*0.25 + vnoise(d*tf*15)*0.15
	base *= 0.92 + 0.16*detail
	// Mineral deposits stain the ground in their colour, in patches whose
	// edges wander like the terrain's.
	if dz := smoothBand(sl, 5, 1); dz.r > 0.01 {
		mc := mineralColor(floor(atlasAt(sl.x, triCorner(sl.yz, 0), 5).g*255/64 + 0.5))
		base = mix(base, mix(base*0.62, mc*0.75, 0.35), smoothstep(0, 0.25, dz.r)*0.75)
	}
	// Deep water is darker than the shallows.
	base *= mix(1, mix(0.55, 1.1, smoothstep(0.1, 0.5, relief.r)), wet)

	// Life moving: gusts of wind rolling across grass and forest, and
	// microbe mats breathing.
	if relief.b > 0.01 {
		gust := sin(dot(d, vec3(0.8, 0.3, 0.5))*tf*0.9 - Time*1.3 + vnoise(d*tf*0.6)*5)
		base *= 1 + 0.09*relief.b*gust*(1-wet)
	}

	// Relief: bend the normal by the slope of the terrain (the tiles'
	// heights, plus the fine detail), found from how the height changes
	// between neighbouring pixels. Water stays flat.
	// Gentler when the tiles are small on screen, where it would look jagged.
	tilePx := 1.27 * Radius * TileAngle // roughly a tile's size on screen
	hgt := (relief.r*2 - 1) * 0.9 * TileAngle * (1 - wet) * mix(0.45, 1, smoothstep(10, 24, tilePx))
	dpx := dfdx(n)
	dpy := dfdy(n)
	c1 := cross(dpy, n)
	c2 := cross(n, dpx)
	det := dot(dpx, c1)
	nb := normalize(abs(det)*n - sign(det)*(dfdx(hgt)*c1+dfdy(hgt)*c2))

	// Tile grid lines, only while placing things and only in a small patch
	// (about two tiles) around the last tapped tile, faded out when tiles
	// are small on screen.
	lineAmt := 1 - clamp(edgePx, 0, 1)
	patch := 1 - smoothstep(1.4*TileAngle, 2.6*TileAngle, length(d-GridAt))
	strength := clamp((tilePx-6)/12, 0, 1) * 0.35 * Grid * patch
	base *= 1 - lineAmt*strength

	// Buildings: art can spill over its tile's edge, so draw the buildings
	// on all three tiles around this point (the corners of its lattice
	// triangle), not just its own. aa is a pixel's size in tile widths.
	aa := length(fwidth(d)) / TileAngle * 1.2
	ndl := dot(n, Light)
	night := smoothstep(0.08, -0.1, ndl)
	glow := vec3(0) // light the buildings give off, added after shading
	for k := 0; k < 3; k++ {
		cij := triCorner(l.yz, k)
		own := cij == ij
		if tilePx < 10 && !own {
			continue // too small to see: each tile just shows its own
		}
		bdata := atlasAt(dm, cij, 1)
		bt := floor(bdata.r*255 + 0.5)
		if bt == 0 && tilePx >= 9 {
			dep := atlasAt(dm, cij, 5)
			if dep.r > 0 {
				id := atlasAt(dm, cij, 2)
				oc := outcrop(tileLocal(d, dm, cij), floor(id.r*255+0.5)+256*floor(id.g*255+0.5), dep.r, mineralColor(floor(dep.g*255/64+0.5)), Mining, aa)
				base = mix(base, oc.rgb, oc.a*smoothstep(9, 14, tilePx))
			}
		}
		if bt == 0 && tilePx >= 18 {
			an := atlasAt(dm, cij, 4)
			if an.r > 0.03 || an.g > 0.03 || an.b > 0.4 {
				id := atlasAt(dm, cij, 2)
				cw := atlasAt(dm, cij, 3).g
				cr := creatures(tileLocal(d, dm, cij), floor(id.r*255+0.5)+256*floor(id.g*255+0.5), an.r, an.g, an.b, cw, aa)
				base = mix(base, cr.rgb, cr.a*smoothstep(18, 28, tilePx))
			}
		}
		if bt > 0 {
			lp := tileLocal(d, dm, cij)
			act := bdata.g
			st := floor(bdata.b*255 + 0.5)
			ap := lp * artScale
			b := building(bt, ap, act, aa*artScale)
			// Stopped buildings fade to grey; short-of-power ones dim a little.
			running := 1.0
			if st > 1.5 {
				grey := dot(b.rgb, vec3(0.3, 0.59, 0.11))
				b.rgb = mix(b.rgb, vec3(grey), 0.65) * 0.8
				running = 0
			} else if st > 0.5 {
				b.rgb *= 0.85
			}
			if tilePx < 10 {
				// Too small for the design to read: fill the tile instead.
				b.a = 1
			} else {
				// Depth: a shadow cast to the south-east, a lit edge on the
				// side facing the sun (north-west), and light falling off
				// across the building.
				sh := building(bt, ap-vec2(0.06, -0.08), act, aa*artScale*2).a
				base *= 1 - 0.45*sh*(1-b.a)
				lit := building(bt, ap+vec2(-0.03, 0.03), act, aa*artScale).a
				b.rgb *= 1.06 - 0.3*dot(ap, vec2(0.6, -0.6))
				b.rgb = mix(b.rgb, min(b.rgb*1.5+0.08, vec3(1)), b.a*(1-lit)*0.8)
				glow += glowOf(bt, ap, act) * running
			}
			// At night, a running colony shows as warm lights.
			glow += vec3(1, 0.72, 0.38) * exp(-dot(lp, lp)/0.03) * night * 0.6 * running * (0.3 + 0.7*act)
			base = mix(base, b.rgb, b.a)
			if tilePx >= 18 {
				bg := badge(st, lp, aa)
				base = mix(base, bg.rgb, bg.a)
			}
		}
	}

	if Mining > 0 {
		// Placing a mine: pick out the deposits and dim everything else.
		dep := atlasAt(dm, ij, 5)
		if dep.r > 0 {
			base = mix(base, mineralColor(floor(dep.g*255/64+0.5)), 0.25)
		} else {
			base *= 0.55
		}
	}
	if Area[0] >= 0 {
		// Tint the tiles the new building would affect, or the inspected
		// hub covers.
		for i := 0; i < 90; i++ {
			if Area[i] == tile {
				base = mix(base, AreaTint, AreaAmt[i])
			}
		}
	}
	if Ghost >= 0 {
		if tile == Ghost {
			gb := building(GhostType, tileLocal(d, dm, ij)*artScale, 1, aa*artScale)
			base = mix(base, gb.rgb, gb.a*0.75)
			// Outline: amber where it can go, red where it can't.
			outline := vec3(1, 0.83, 0.42)
			if GhostOK < 0.5 {
				outline = vec3(1, 0.42, 0.36)
			}
			if edgePx < 2.5 {
				base = outline
			}
		}
	}

	if Selected >= 0 && tile == Selected {
		pulse := 0.5 + 0.5*sin(Time*6)
		base = mix(base, vec3(1, 0.85, 0.2), 0.45+0.25*pulse)
	}

	// Sunlight on the relief, and a glint off open water.
	diff := max(dot(nb, Light), 0)
	col := base * (0.12 + 0.98*diff)
	half := normalize(Light + vec3(0, 0, 1))
	col += vec3(1, 0.97, 0.9) * pow(max(dot(n, half), 0), 90) * wet * 0.45

	// Clouds drift slowly round the planet and shade the ground beneath
	// them. They fade out as you zoom in, so they never hide the colony.
	cloudAmt := Clouds * (1 - smoothstep(16, 40, tilePx))
	if cloudAmt > 0.01 {
		a := Time * 0.006
		cd := vec3(d.x*cos(a)-d.z*sin(a), d.y, d.x*sin(a)+d.z*cos(a))
		lp := Row0*Light.x + Row1*Light.y + Row2*Light.z // the sun, planet space
		lpr := vec3(lp.x*cos(a)-lp.z*sin(a), lp.y, lp.x*sin(a)+lp.z*cos(a))
		col *= 1 - 0.4*cloudsAt(cd-lpr*0.02)*cloudAmt
		cl := cloudsAt(cd)
		col = mix(col, vec3(0.95, 0.96, 1)*(0.06+1.0*pow(max(ndl, 0), 0.7)), cl*0.8*cloudAmt)
	}

	// Twilight: thick air glows warm along the line between day and night.
	col += vec3(0.3, 0.11, 0.03) * exp(-pow((ndl-0.04)/0.12, 2)) * 0.35 * Air
	col += glow

	rim := pow(1-n.z, 3)
	col = mix(col, atmo*(0.25+0.85*max(ndl+0.2, 0)), rim*(0.4+0.35*Air))
	return vec4(col, 1)
}
