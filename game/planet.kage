//kage:unit pixels

package main

// Draws the starfield and the planet as a ray-traced sphere on one screen quad.
// Source image 0 is the tile atlas, (6·P)×(2·P) with P = N+2: one P×P block
// per cube face, holding its N×N tiles plus a one-tile border copied from
// neighbouring faces. The top half is tile colour; the bottom half is
// building data (red: type + 1, or 0 for none; green: activity 0..1).
//
// Tile colours are blended smoothly and broken up with noise so the planet
// looks natural rather than like a cube of squares; buildings, selection and
// grid lines still follow the tiles.

var Center vec2   // planet centre on screen, pixels
var Radius float  // planet radius on screen, pixels
var Row0 vec3     // rows of the world-to-view rotation
var Row1 vec3
var Row2 vec3
var N float       // cells per face edge
var Selected vec3 // selected cell (face, i, j); face < 0 means none
var Time float    // seconds
var Light vec3    // unit light direction, view space
var Grid float    // tile grid line strength, 0 to hide
var GridAt vec3   // planet-space centre of the patch where grid lines show

// faceUV mirrors sim.faceUV: returns (face, u, v) with u, v in [-1, 1], on
// the equal-angle grid.
func faceUV(d vec3) vec3 {
	f := cubeFaceUV(d)
	return vec3(f.x, atan(f.yz)*4/3.14159265)
}

func cubeFaceUV(d vec3) vec3 {
	a := abs(d)
	if a.x >= a.y && a.x >= a.z {
		if d.x > 0 {
			return vec3(0, -d.z/a.x, d.y/a.x)
		}
		return vec3(1, d.z/a.x, d.y/a.x)
	}
	if a.y >= a.z {
		if d.y > 0 {
			return vec3(2, d.x/a.y, -d.z/a.y)
		}
		return vec3(3, d.x/a.y, d.z/a.y)
	}
	if d.z > 0 {
		return vec3(4, d.x/a.z, d.y/a.z)
	}
	return vec3(5, -d.x/a.z, d.y/a.z)
}

// dirFromFaceUV mirrors sim.dirFromFaceUV: the cube point for (face, u, v)
// on the equal-angle grid.
func dirFromFaceUV(face float, u float, v float) vec3 {
	return cubeDir(face, tan(u*3.14159265/4), tan(v*3.14159265/4))
}

func cubeDir(face float, u float, v float) vec3 {
	if face == 0 {
		return vec3(1, v, -u)
	}
	if face == 1 {
		return vec3(-1, v, u)
	}
	if face == 2 {
		return vec3(u, 1, -v)
	}
	if face == 3 {
		return vec3(u, -1, v)
	}
	if face == 4 {
		return vec3(u, v, 1)
	}
	return vec3(-u, v, -1)
}

// tileLocal returns where planet-space direction d falls relative to the
// centre of tile ij on face, measured on the plane touching the sphere at the
// tile centre, oriented north-up, in units of the tile's width. Unlike the
// face's own (u, v) grid it isn't skewed near cube corners, so building
// symbols drawn in it keep their shape.
func tileLocal(d vec3, face float, ij vec2) vec2 {
	uv := (ij+0.5)/N*2 - 1
	c := normalize(dirFromFaceUV(face, uv.x, uv.y))
	size := length(normalize(dirFromFaceUV(face, uv.x+2/N, uv.y)) - c)
	up := vec3(0, 1, 0)
	if abs(c.y) > 0.99 {
		up = vec3(0, 0, 1)
	}
	east := normalize(cross(up, c))
	north := cross(c, east)
	off := d/dot(d, c) - c
	return vec2(dot(off, east), dot(off, north)) / size
}

// building returns the colour (rgb) and coverage (a) of building type bt at
// tile-local position p, each axis in [-0.5, 0.5].
// Types follow sim.BuildingType + 1.
func building(bt float, p vec2) vec4 {
	r := length(p)
	box := max(abs(p.x), abs(p.y))
	if bt == 1 { // lander: white disc with a cyan core
		if r < 0.18 {
			return vec4(0.3, 0.85, 1, 1)
		}
		return vec4(0.95, 0.95, 1, step(r, 0.4))
	}
	if bt == 2 { // solar: blue panel with a grid
		gp := fract((p + 0.5) * 3)
		line := step(min(gp.x, gp.y), 0.12)
		return vec4(mix(vec3(0.1, 0.2, 0.55), vec3(0.5, 0.65, 0.9), line), step(box, 0.4))
	}
	if bt == 3 { // mine: grey diamond with a dark pit
		d := abs(p.x) + abs(p.y)
		if d < 0.16 {
			return vec4(0.12, 0.1, 0.1, 1)
		}
		return vec4(0.55, 0.55, 0.6, step(d, 0.45))
	}
	if bt == 4 { // smelter: orange block with a chimney
		if abs(p.x-0.18) < 0.08 && p.y > 0.05 && p.y < 0.45 {
			return vec4(0.2, 0.2, 0.22, 1)
		}
		return vec4(0.95, 0.5, 0.12, step(max(abs(p.x), abs(p.y+0.08)), 0.3))
	}
	if bt == 5 { // heater: red ring around a hot core
		if r < 0.16 {
			return vec4(1, 0.85, 0.3, 1)
		}
		return vec4(0.95, 0.25, 0.12, step(0.24, r)*step(r, 0.42))
	}
	return vec4(0)
}

func hash3(p vec3) float {
	return fract(sin(dot(p, vec3(127.1, 311.7, 74.7))) * 43758.5453)
}

// vnoise is 3D value noise in [0, 1]. Evaluated in planet space, so it's
// continuous across cube seams.
func vnoise(p vec3) float {
	i := floor(p)
	t := fract(p)
	u := t * t * (3 - 2*t)
	a := mix(hash3(i), hash3(i+vec3(1, 0, 0)), u.x)
	b := mix(hash3(i+vec3(0, 1, 0)), hash3(i+vec3(1, 1, 0)), u.x)
	c := mix(hash3(i+vec3(0, 0, 1)), hash3(i+vec3(1, 0, 1)), u.x)
	e := mix(hash3(i+vec3(0, 1, 1)), hash3(i+vec3(1, 1, 1)), u.x)
	return mix(mix(a, b, u.y), mix(c, e, u.y), u.z)
}

// smoothColor blends the colours of the four tiles nearest planet direction
// d. The atlas border supplies tiles from neighbouring faces at seams.
func smoothColor(d vec3) vec3 {
	f := faceUV(d)
	p := (f.yz+1)/2*N - 0.5 // in tile-centre coordinates
	i0 := floor(p)
	fr := smoothstep(vec2(0.1), vec2(0.9), p-i0)
	at := imageSrc0Origin() + vec2(f.x*(N+2)+1.5, 1.5) + i0
	c0 := mix(imageSrc0UnsafeAt(at).rgb, imageSrc0UnsafeAt(at+vec2(1, 0)).rgb, fr.x)
	c1 := mix(imageSrc0UnsafeAt(at+vec2(0, 1)).rgb, imageSrc0UnsafeAt(at+vec2(1, 1)).rgb, fr.x)
	return mix(c0, c1, fr.y)
}

func hash(p vec2) float {
	return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453)
}

func Fragment(dstPos vec4, srcPos vec2, color vec4) vec4 {
	atmo := vec3(0.45, 0.62, 1.0)

	// Screen position relative to the planet, y up.
	q := (dstPos.xy - Center) / Radius
	q = vec2(q.x, -q.y)
	r2 := dot(q, q)

	if r2 > 1 {
		space := vec3(0.01, 0.012, 0.03)
		h := hash(floor(dstPos.xy))
		if h > 0.997 {
			space += vec3((h - 0.997) / 0.003 * 0.8)
		}
		// Thin atmospheric halo just outside the limb.
		g := clamp(1-(sqrt(r2)-1)/0.06, 0, 1)
		return vec4(mix(space, atmo, g*g*0.5), 1)
	}

	// Surface normal in view space, then rotate back to planet space.
	n := vec3(q, sqrt(1-r2))
	d := Row0*n.x + Row1*n.y + Row2*n.z

	f := faceUV(d)
	st := (f.yz + 1) / 2 * N
	ij := clamp(floor(st), vec2(0), vec2(N-1))

	// Warp the colour lookup with noise so region edges wander organically
	// instead of following the grid, then add fine surface texture.
	tileAngle := 1.5708 / N
	q3 := d * N * 0.9
	warp := vec3(vnoise(q3), vnoise(q3+vec3(17.3, 5.1, 9.7)), vnoise(q3+vec3(41.7, 23.9, 3.3))) - 0.5
	base := smoothColor(normalize(d + warp*tileAngle*1.4))
	detail := vnoise(d*N*2.5)*0.7 + vnoise(d*N*6)*0.3
	base *= 0.92 + 0.16*detail

	// Tile grid lines, only while placing things and only in a small patch
	// around the last tapped tile (so the cube layout never shows), faded
	// out when tiles are small on screen.
	g := fract(st)
	w := max(fwidth(st), vec2(1e-4))
	edge := min(min(g.x, 1-g.x)/w.x, min(g.y, 1-g.y)/w.y)
	lineAmt := 1 - clamp(edge, 0, 1)
	patch := 1 - smoothstep(2*tileAngle, 4*tileAngle, length(d-GridAt))
	strength := clamp((2*Radius/N-6)/12, 0, 1) * 0.35 * Grid * patch
	base *= 1 - lineAmt*strength

	bdata := imageSrc0UnsafeAt(imageSrc0Origin() + vec2(f.x*(N+2)+ij.x+1.5, N+2+ij.y+1.5))
	bt := floor(bdata.r*255 + 0.5)
	if bt > 0 {
		b := building(bt, tileLocal(d, f.x, ij))
		// Idle buildings (unpowered, starved or full) pulse red.
		if bdata.g < 0.05 {
			b.rgb = mix(b.rgb, vec3(0.8, 0.1, 0.1), 0.35+0.35*sin(Time*5))
		}
		// When tiles are too small on screen for the symbol to read,
		// fill the whole tile with the building's colour instead.
		if 2*Radius/N < 10 {
			b.a = 1
		}
		base = mix(base, b.rgb, b.a)
	}

	if Selected.x >= 0 && f.x == Selected.x && ij.x == Selected.y && ij.y == Selected.z {
		pulse := 0.5 + 0.5*sin(Time*6)
		base = mix(base, vec3(1, 0.85, 0.2), 0.45+0.25*pulse)
	}

	diff := max(dot(n, Light), 0)
	col := base * (0.15 + 0.95*diff)

	rim := pow(1-n.z, 3)
	col = mix(col, atmo, rim*0.55)
	return vec4(col, 1)
}
